<Window x:Class="LineMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LineMonitor.App"
        xmlns:controls="clr-namespace:LineMonitor.App.Controls"
        xmlns:conv="clr-namespace:LineMonitor.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="라인 실시간 모니터링" Height="900" Width="1500"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource BgBrush}">
    <shell:WindowChrome.WindowChrome>
        <!-- GlassFrameThickness=0이 핵심 — 이게 있어야 DWM이 창 위쪽에 포커스 액센트색 얇은 선을 안 그림 -->
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="5" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToLiveBrushConverter x:Key="LiveBrush2" />
        <ItemsPanelTemplate x:Key="DashboardBoxesPanel">
            <controls:WorkspaceCanvas Height="3000" />
        </ItemsPanelTemplate>
        <Style x:Key="ErrorProofButton" TargetType="Button">
            <Setter Property="Background" Value="#B9DEE5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LayoutPresetTab" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 커스텀 타이틀바: 어두운 회색 바탕 + 흰 글씨, 창 기본 크롬 대신 직접 그림 -->
        <Border DockPanel.Dock="Top" Background="#2B2F36" Height="36" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <TextBlock x:Name="WindowTitleText" Text="라인 실시간 모니터링" Foreground="White" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick" ToolTip="최소화">
                        <Border Width="10" Height="1.4" Background="White" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMaximizeClick" ToolTip="최대화/복원">
                        <Border Width="9" Height="9" BorderBrush="White" BorderThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick" ToolTip="닫기">
                        <Canvas Width="10" Height="10">
                            <Line X1="0" Y1="0" X2="10" Y2="10" Stroke="White" StrokeThickness="1.3" />
                            <Line X1="0" Y1="10" X2="10" Y2="0" Stroke="White" StrokeThickness="1.3" />
                        </Canvas>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 상단 바: 라인 선택, Live 상태, UI 프리셋 -->
        <Border x:Name="MainToolbar" DockPanel.Dock="Top" Background="{StaticResource BgBrush}" Padding="12,8" MinHeight="48">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LineSelectionText" Text="{Binding SelectionDisplayName}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0"
                           Cursor="Hand" ToolTip="더블클릭해서 라인 변경"
                           MouseLeftButtonDown="OnLineNameMouseLeftButtonDown" />

                <StackPanel x:Name="LiveControls" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="140,0,0,0">
                    <Button Content="Live 토글" Command="{Binding ToggleLiveCommand}" Style="{StaticResource PillButton}" />
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="14,0,6,0"
                             Fill="{Binding IsLive, Converter={StaticResource LiveBrush2}}" />
                    <TextBlock Text="Live" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                </StackPanel>

                <StackPanel x:Name="NavigationControls" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="300,0,0,0" ToolTip="현재 창에서 화면을 전환합니다. 별도 창은 새 창 버튼으로 엽니다.">
                    <Button x:Name="LayoutPreset1Button" Content="UI 프리셋1" Tag="1"
                                 Style="{StaticResource LayoutPresetTab}"
                                 Click="OnLayoutPresetClick" />
                    <Button x:Name="LayoutPreset2Button" Content="UI 프리셋2" Tag="2"
                                 Style="{StaticResource LayoutPresetTab}"
                                 Click="OnLayoutPresetClick" />
                    <Button x:Name="HistoryInquiryButton" Content="이력조회"
                            Style="{StaticResource LayoutPresetTab}" Click="OnHistoryInquiryClick" />
                    <Button x:Name="NewWindowButton" Content="새 창" Style="{StaticResource LayoutPresetTab}"
                            Click="OnNewWindowClick" ToolTip="현재 화면을 별도 작업창으로 엽니다." />
                    <Button x:Name="LayoutLockButton" Content="UI 잠금" Style="{StaticResource LayoutPresetTab}"
                            Click="OnLayoutLockClick" ToolTip="박스 이동·크기 변경·추가·삭제를 잠급니다." />
                </StackPanel>

                <!-- Ctrl+클릭으로 박스 여러 개 고른 뒤 마지막으로 고른 박스 크기에 맞춤(MFC "동일하게" 기능) -->
                <StackPanel x:Name="SizeMatchControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="크기 맞춤: " VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,6,0" />
                    <Button x:Name="MatchWidthButton" Content="가로" Style="{StaticResource PillButton}" Padding="10,4"
                            Margin="0,0,4,0" IsEnabled="False" Click="OnMatchWidthClick" ToolTip="기준 박스의 너비와 왼쪽 위치에 맞춤" />
                    <Button x:Name="MatchHeightButton" Content="세로" Style="{StaticResource PillButton}" Padding="10,4"
                            Margin="0,0,4,0" IsEnabled="False" Click="OnMatchHeightClick" ToolTip="마지막으로 고른 박스 세로에 맞춤" />
                    <Button x:Name="MatchBothButton" Content="가로+세로" Style="{StaticResource PillButton}" Padding="10,4"
                            IsEnabled="False" Click="OnMatchBothClick" ToolTip="기준 박스의 크기와 왼쪽 위치에 맞춤" />
                </StackPanel>

                <StackPanel x:Name="ErrorProofControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Style="{StaticResource ErrorProofButton}" Margin="0,0,8,0"
                            Click="OnOpenErrorProofResultsClick" ToolTip="D:\Data\ErrorProof\ 폴더 열기">
                        <StackPanel>
                            <TextBlock Text="에러프루프" HorizontalAlignment="Center" />
                            <TextBlock Text="결과 바로가기" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="에러프루프 시작" Style="{StaticResource ErrorProofButton}"
                            Click="OnStartErrorProofClick" ToolTip="현재 선택한 DB에 에러프루프 시작 신호를 전송합니다." />
                </StackPanel>

                <Image x:Name="ToolbarLogo" Grid.Column="3" Source="/Assets/logo.png" Height="28" VerticalAlignment="Center" Margin="0" />
            </Grid>
        </Border>

        <Border x:Name="MainSummaryBar" DockPanel.Dock="Top" Background="{StaticResource BgBrush}" Padding="8,0,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Center">
                <Border Style="{StaticResource CardBorder}" MinWidth="200">
                    <TextBlock Text="{Binding LiveOverview.LotId, Mode=OneWay, StringFormat='LOT ID : {0}'}"
                               Style="{StaticResource ValueText}" />
                </Border>
                <Border Style="{StaticResource CardBorder}" MinWidth="160">
                    <TextBlock Text="{Binding LiveOverview.Meter, Mode=OneWay, StringFormat='Meter : {0}'}"
                               Style="{StaticResource ValueText}" />
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <TextBlock Text="OS 라벨 부착 수량 : -" Style="{StaticResource ValueText}" />
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <TextBlock Text="DS 라벨 부착 수량 : -" Style="{StaticResource ValueText}" />
                </Border>
                <Border Style="{StaticResource CardBorder}" MinWidth="220">
                    <TextBlock Text="{Binding DefectHistory.TopDefectsSummary, Mode=OneWay, StringFormat='표면 불량 top 3 : {0}'}"
                               Style="{StaticResource ValueText}" TextWrapping="Wrap" />
                </Border>
            </WrapPanel>
                <Border Grid.Column="2" Margin="8,4,4,4" Padding="12,8" CornerRadius="4"
                        VerticalAlignment="Center"
                        ToolTip="DB 서버 응답 상태입니다. 설비·PLC의 운전 상태와는 다릅니다.">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#D9DDE3" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDatabaseConnected}" Value="True">
                                    <Setter Property="Background" Value="#00E600" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDatabaseConnected}" Value="False">
                                    <Setter Property="Background" Value="#FF4D4F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding DatabaseStatusText}" Foreground="Black" FontSize="16"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Grid>
        <!-- 사이드바(토글 열 + 크기조절 가능한 내용 열) + 굵은 스플리터 + 작업영역, 전부 한 Grid 안 -->
        <Grid x:Name="DashboardWorkspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition x:Name="SidebarContentColumn" Width="228" MinWidth="160" MaxWidth="520" />
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 클로드 앱 느낌(살짝 다른 배경톤, 테두리 없음, 둥근 hover 행) -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <Button x:Name="SidebarToggleButton" Style="{StaticResource SidebarToggleButton}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,8,0,0"
                        Click="OnSidebarToggleClick" ToolTip="사이드바 접기/펼치기">
                    <!-- 패널 아이콘: 둥근 사각형 + 세로 분할선(클로드 사이드바 토글 아이콘 느낌) -->
                    <Grid Width="16" Height="14">
                        <Border BorderBrush="{StaticResource MutedBrush}" BorderThickness="1.3" CornerRadius="2" />
                        <Border BorderBrush="{StaticResource MutedBrush}" BorderThickness="1.3,0,0,0"
                                Width="1" HorizontalAlignment="Left" Margin="5,0,0,0" />
                    </Grid>
                </Button>
            </Border>

            <Border Grid.Column="1" x:Name="SidebarContent" Background="{StaticResource SidebarBgBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,16,14,10">
                        <TextBlock Text="박스 목록" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="작업 영역으로 드래그하거나 더블클릭해서 추가" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ListBox x:Name="CatalogList" Margin="4,0,4,4" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SidebarListItem}"
                             MouseDoubleClick="OnCatalogItemMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel x:Name="Row" Orientation="Horizontal"
                                            PreviewMouseLeftButtonDown="OnCatalogRowPreviewMouseLeftButtonDown"
                                            PreviewMouseMove="OnCatalogRowPreviewMouseMove">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Title}" FontSize="16" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.35" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 사이드바 폭 조절용 굵은 스플리터 — 평소엔 진한 회색 선, hover하면 액센트색 -->
            <GridSplitter x:Name="SidebarWidthSplitter" Grid.Column="2" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush2}" Style="{StaticResource SidebarSplitter}" />

            <!-- 작업 영역: Canvas 기반 자유배치 — 창 크기 바뀌어도 재정렬 안 되고 박스가 각자 X/Y 좌표를 유지함 -->
            <Grid Grid.Column="3">
                <ScrollViewer x:Name="BoxesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Stretch"
                              AllowDrop="True" DragOver="OnCanvasDragOver" Drop="OnCanvasDrop">
                    <ItemsControl x:Name="BoxesPanel" Margin="8" Grid.IsSharedSizeScope="True"
                                  ItemsPanel="{StaticResource DashboardBoxesPanel}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Card}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 빈 작업 영역 안내 문구 — 박스가 하나라도 놓이면 코드비하인드에서 Collapsed 처리 -->
                <TextBlock x:Name="EmptyCanvasHint" Text="여기에 박스를 드래그하세요"
                           FontSize="20" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>
            <controls:HistoryInquiryPanel x:Name="HistoryInquiryView" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
