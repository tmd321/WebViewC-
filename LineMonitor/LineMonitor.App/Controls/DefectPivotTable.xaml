<UserControl x:Class="LineMonitor.App.Controls.DefectPivotTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="PivotCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="TopDefectCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="#CFE3FF" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
    <DataGrid x:Name="PivotGrid" ItemsSource="{Binding PivotRows}"
              AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              Background="Transparent" RowBackground="Transparent"
              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
              CanUserAddRows="False" Margin="8">
        <DataGrid.Columns>
            <DataGridTextColumn Header="개소" Binding="{Binding Location, Mode=OneWay}" Width="230"
                                ElementStyle="{StaticResource PivotCellText}" />
            <DataGridTextColumn Header="TOP 1" Binding="{Binding Top1, Mode=OneWay}" Width="130"
                                ElementStyle="{StaticResource PivotCellText}" CellStyle="{StaticResource TopDefectCell}" />
            <DataGridTextColumn Header="TOP 2" Binding="{Binding Top2, Mode=OneWay}" Width="130"
                                ElementStyle="{StaticResource PivotCellText}" CellStyle="{StaticResource TopDefectCell}" />
            <DataGridTextColumn Header="TOP 3" Binding="{Binding Top3, Mode=OneWay}" Width="130"
                                ElementStyle="{StaticResource PivotCellText}" CellStyle="{StaticResource TopDefectCell}" />
            <DataGridTextColumn Header="총 불량 수" Binding="{Binding Total, Mode=OneWay, StringFormat='{}{0:#,##0;-#,##0;-}'}" Width="110"
                                ElementStyle="{StaticResource PivotCellText}" />
        </DataGrid.Columns>
    </DataGrid>
    </DockPanel>
</UserControl>
