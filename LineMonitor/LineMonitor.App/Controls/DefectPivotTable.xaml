<UserControl x:Class="LineMonitor.App.Controls.DefectPivotTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataGrid x:Name="PivotGrid" ItemsSource="{Binding PivotRows}"
              AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              Background="Transparent" RowBackground="Transparent"
              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
              CanUserAddRows="False" Margin="8">
        <DataGrid.Columns>
            <DataGridTextColumn Header="개소" Binding="{Binding Location}" Width="180" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
