<UserControl x:Class="LineMonitor.App.Controls.MismatchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LineMonitor.Core.Models;assembly=LineMonitor.Core"
             xmlns:conv="clr-namespace:LineMonitor.App.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:SignToBrushConverter x:Key="SignToBrush" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}">
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BorderBrush2}" Padding="6,2" CornerRadius="3">
                    <TextBlock Text="{Binding LeftLabel, ElementName=Root}" FontWeight="Bold" />
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="6,2">
                        <TextBlock Text="(+) : BACK이 큼, (-) : TOP이 큼" Style="{StaticResource MutedText}" />
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource BorderBrush2}" Padding="6,2" CornerRadius="3">
                    <TextBlock Text="{Binding RightLabel, ElementName=Root}" FontWeight="Bold" />
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LaneMismatch}">
                        <StackPanel Margin="2">
                            <Border Height="4" Background="Black" Margin="0,0,0,4" CornerRadius="2" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Left, StringFormat='{}{0:0.00}'}"
                                           Foreground="{Binding Left, Converter={StaticResource SignToBrush}}" Margin="0,0,4,0" />
                                <TextBlock Text="|" Style="{StaticResource MutedText}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Right, StringFormat='{}{0:0.00}'}"
                                           Foreground="{Binding Right, Converter={StaticResource SignToBrush}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
