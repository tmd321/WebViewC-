<UserControl x:Class="LineMonitor.App.Controls.MismatchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LineMonitor.Core.Models;assembly=LineMonitor.Core"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="MaterialStrip" TargetType="Border">
            <Setter Property="Background" Value="#C0C0C0" />
            <Setter Property="Height" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPositiveElectrode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                    <Setter Property="Background" Value="#D99A32" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}">
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BorderBrush2}" Padding="6,2" CornerRadius="3">
                    <TextBlock Text="{Binding LeftLabel, ElementName=Root}" FontWeight="Bold" />
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <Border Background="#218653" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="(+) : BACK이 큼, (-) : TOP이 큼" Style="{StaticResource MutedText}"
                                   Foreground="White" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource BorderBrush2}" Padding="6,2" CornerRadius="3">
                    <TextBlock Text="{Binding RightLabel, ElementName=Root}" FontWeight="Bold" />
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LaneMismatch}">
                        <StackPanel Margin="0,2">
                            <Grid Height="16" Margin="0,0,0,4">
                                <Border Height="6" Background="Black" VerticalAlignment="Top" Margin="2,0" />
                                <Border Height="6" Background="Black" VerticalAlignment="Bottom" Margin="2,0" />
                                <Border Style="{StaticResource MaterialStrip}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Left, StringFormat='{}{0:0.00}'}"
                                           FontWeight="Bold" FontSize="16"
                                           Foreground="Black" Margin="0,0,4,0" />
                                <TextBlock Text="|" Style="{StaticResource MutedText}" Foreground="Black" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Right, StringFormat='{}{0:0.00}'}"
                                           FontWeight="Bold" FontSize="16"
                                           Foreground="Black" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
