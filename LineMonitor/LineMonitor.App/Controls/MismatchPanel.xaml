<UserControl x:Class="LineMonitor.App.Controls.MismatchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LineMonitor.Core.Models;assembly=LineMonitor.Core"
             xmlns:conv="clr-namespace:LineMonitor.App.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:OutOfSpecBrushConverter x:Key="SpecBrush" />
        <conv:MirrorMeasurementConverter x:Key="MirrorMeasurement" />
        <conv:MismatchBarMarginConverter x:Key="MismatchBarMargin" />
        <Style x:Key="MaterialStrip" TargetType="Border">
            <Setter Property="Background" Value="#C0C0C0" />
            <Setter Property="Height" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCathodeElectrode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                    <Setter Property="Background" Value="#D99A32" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}" Padding="12,3">
        <Border.DataContext>
            <MultiBinding Converter="{StaticResource MirrorMeasurement}" Mode="OneWay">
                <Binding Path="DataContext" ElementName="Root" />
                <Binding Path="IsMirrored" ElementName="Root" />
                <!-- 반전한 목록도 실시간 컬렉션의 Clear/Add마다 다시 만든다. -->
                <Binding Path="DataContext.Count" ElementName="Root" />
            </MultiBinding>
        </Border.DataContext>
        <StackPanel>
            <Grid x:Name="MeasurementTitleArea" Margin="0,0,0,2" Background="Transparent"
                  ToolTip="더블클릭해서 이 미스매치 화면의 좌우 방향을 반전합니다.">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="FlowDirection" Value="LeftToRight" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMirrored, ElementName=Root}" Value="True">
                                <Setter Property="FlowDirection" Value="RightToLeft" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="Black" Padding="6,2" CornerRadius="3">
                    <TextBlock Text="{Binding LeftLabel, ElementName=Root}" FontWeight="Bold" Foreground="White" FontSize="18" />
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" FlowDirection="LeftToRight">
                    <TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="Bold" FontSize="18"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <Border Background="#218653" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="(+) : BACK이 큼, (-) : TOP이 큼" Style="{StaticResource MutedText}"
                                   Foreground="White" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Background="Black" Padding="6,2" CornerRadius="3">
                    <TextBlock Text="{Binding RightLabel, ElementName=Root}" FontWeight="Bold" Foreground="White" FontSize="18" />
                </Border>
            </Grid>

            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LaneStripLabels" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="LaneStripAverage" />
                </Grid.ColumnDefinitions>
                <Grid Width="50" Height="32" VerticalAlignment="Top" Margin="0,2,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Back" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="Top" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LaneMismatch}">
                        <StackPanel>
                            <Grid Height="32" Margin="0,0,0,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Height="11" Background="Black" VerticalAlignment="Center"
                                        Margin="{Binding Converter={StaticResource MismatchBarMargin}, ConverterParameter=Back}" />
                                <Border Grid.Row="1" Height="11" Background="Black" VerticalAlignment="Center"
                                        Margin="{Binding Converter={StaticResource MismatchBarMargin}, ConverterParameter=Top}" />
                                <Border Grid.RowSpan="2" Style="{StaticResource MaterialStrip}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Left, StringFormat='{}{0:0.00}', TargetNullValue=-}"
                                           FontWeight="Bold" FontSize="22"
                                           Foreground="{Binding IsLeftOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={x:Static Brushes.Black}}" Margin="0,0,4,0" />
                                <TextBlock Text="|" Style="{StaticResource MutedText}" Foreground="Black" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Right, StringFormat='{}{0:0.00}', TargetNullValue=-}"
                                           FontWeight="Bold" FontSize="22"
                                           Foreground="{Binding IsRightOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={x:Static Brushes.Black}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
