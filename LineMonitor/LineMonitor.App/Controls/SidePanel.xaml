<UserControl x:Class="LineMonitor.App.Controls.SidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LineMonitor.Core.Models;assembly=LineMonitor.Core"
             xmlns:conv="clr-namespace:LineMonitor.App.Converters"
             xmlns:controls="clr-namespace:LineMonitor.App.Controls"
             x:Name="Root" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <conv:OutOfSpecBrushConverter x:Key="SpecBrush" />
        <SolidColorBrush x:Key="DryValueBrush" Color="#FFD940" />
        <SolidColorBrush x:Key="InsulWetValueBrush" Color="#8B96AB" />
        <conv:MirrorMeasurementConverter x:Key="MirrorMeasurement" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:CollectionHasItemsConverter x:Key="HasItems" />
        <conv:LengthToWidthConverter x:Key="LenToWidth" />
        <Style x:Key="LaneMeasurementStrip" TargetType="ItemsControl">
            <Setter Property="Background" Value="#C0C0C0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowInsulation, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                    <Setter Property="Background" Value="#D99A32" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LaneMeasurementBorder" TargetType="Border">
            <Setter Property="Background" Value="Black" />
            <Setter Property="BorderBrush" Value="#C0C0C0" />
            <Setter Property="BorderThickness" Value="6,0,6,0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowInsulation, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                    <Setter Property="BorderBrush" Value="#D99A32" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}" Padding="12,3">
        <Border.DataContext>
            <MultiBinding Converter="{StaticResource MirrorMeasurement}" Mode="OneWay">
                <Binding Path="DataContext" ElementName="Root" />
                <Binding Path="IsMirrored" ElementName="Root" />
            </MultiBinding>
        </Border.DataContext>
        <StackPanel>
            <!-- DS Lane1 ... TOP/BACK ... LaneN OS -->
            <Grid x:Name="MeasurementTitleArea" Margin="0,0,0,2" Background="Transparent"
                  ToolTip="더블클릭해서 이 측정 화면의 좌우 방향을 반전합니다.">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="FlowDirection" Value="LeftToRight" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMirrored, ElementName=Root}" Value="True">
                                <Setter Property="FlowDirection" Value="RightToLeft" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Border Background="Black" Padding="6,2" CornerRadius="3" Margin="0,0,6,0">
                        <TextBlock Text="DS" FontWeight="Bold" Foreground="White" FontSize="18" />
                    </Border>
                    <Border Background="Black" Padding="6,2" CornerRadius="3">
                        <TextBlock Text="Lane 1" FlowDirection="LeftToRight" FontWeight="Bold" Foreground="White" FontSize="18" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Title, ElementName=Root}"
                           FlowDirection="LeftToRight"
                           FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />

                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                    <Border Background="Black" Padding="6,2" CornerRadius="3" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Lanes.Count, StringFormat='Lane {0}'}" FlowDirection="LeftToRight" FontWeight="Bold" Foreground="White" FontSize="18" />
                    </Border>
                    <Border Background="Black" Padding="6,2" CornerRadius="3">
                        <TextBlock Text="OS" FontWeight="Bold" Foreground="White" FontSize="18" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 스트라이프 코팅 패턴(최대 8) + 패턴 사이 무지부(포일) -->
            <Border Visibility="{Binding Patterns, Converter={StaticResource HasItems}}"
                    Background="{StaticResource BgBrush}" CornerRadius="3" Padding="4" Margin="0,0,0,6">
                <ItemsControl ItemsSource="{Binding Patterns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PatternSegment}">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource AccentBrush}" Height="28" Margin="1" CornerRadius="2"
                                        Width="{Binding CoatLength, Converter={StaticResource LenToWidth}}"
                                        ToolTip="{Binding CoatLength, StringFormat='Coat {0:0.0}mm'}">
                                    <TextBlock Text="{Binding Index, StringFormat='P{0}'}" Foreground="White" FontSize="13"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Background="{StaticResource BorderBrush2}" Height="28" Margin="1" CornerRadius="2"
                                        Width="{Binding FoilLength, Converter={StaticResource LenToWidth}, ConverterParameter=1.5}"
                                        Visibility="{Binding FoilLength, Converter={StaticResource NullToVis}}"
                                        ToolTip="{Binding FoilLength, StringFormat='Foil {0:0.0}mm'}">
                                    <TextBlock Text="Foil" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 무지부와 코팅 레인은 같은 가로 폭을 사용하고 평균 영역은 따로 둔다. -->
            <Grid Margin="24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LaneStripLabels" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="LaneStripAverage" />
                </Grid.ColumnDefinitions>

            <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Edges}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:LaneBoundaryPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EdgeReading}">
                        <StackPanel HorizontalAlignment="Center" Margin="2,0">
                            <TextBlock Text="{Binding CutLabel}" Style="{StaticResource MutedText}"
                                       Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Center"
                                       Visibility="{Binding CutLabel, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding Wet, StringFormat='{}{0:0.00}'}" Style="{StaticResource MutedText}"
                                       Foreground="{Binding IsWetOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={StaticResource MutedBrush}}"
                                       FontWeight="Normal" FontSize="18" HorizontalAlignment="Center"
                                       Visibility="{Binding CutLabel, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                            <TextBlock Text="{Binding Dry, StringFormat='{}{0:0.00}'}" Style="{StaticResource MutedText}"
                                       Foreground="{Binding IsDryOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={StaticResource MutedBrush}}"
                                       FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"
                                       Visibility="{Binding CutLabel, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Lanes}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LaneWetDry}">
                            <Border Background="#BFBFBF" CornerRadius="4" Padding="6,2"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="2,0"
                                    Visibility="{Binding CutLabel, Converter={StaticResource NullToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CutLabel}" Foreground="Black" FontSize="14"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CutWidth, StringFormat='{}{0:0.00}', TargetNullValue=-}"
                                               Foreground="{Binding IsCutWidthOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={x:Static Brushes.Yellow}}" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,6,5"
                            Visibility="{Binding ShowInsulation, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="절연 Wet" FontSize="13" FontWeight="Normal" Foreground="Black" HorizontalAlignment="Right" />
                    <TextBlock Text="절연 Dry" FontSize="15" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right" />
                </StackPanel>

                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Lanes}" Style="{StaticResource LaneMeasurementStrip}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LaneWetDry}">
                            <Border Style="{StaticResource LaneMeasurementBorder}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Wet, StringFormat='{}{0:0.00}'}"
                                               Foreground="{Binding IsWetOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={x:Static Brushes.White}}"
                                               FontWeight="Normal" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Dry, StringFormat='{}{0:0.00}'}"
                                               Foreground="{Binding IsDryOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={StaticResource DryValueBrush}}"
                                               FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" />
                                    <Grid Margin="0,4,0,0"
                                                Visibility="{Binding ShowInsulation, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding InsulWetLeft, StringFormat='{}{0:0.00}'}" Foreground="{Binding IsInsulWetLeftOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={StaticResource InsulWetValueBrush}}" FontSize="17" FontWeight="Normal" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding InsulWetRight, StringFormat='{}{0:0.00}'}" Foreground="{Binding IsInsulWetRightOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={StaticResource InsulWetValueBrush}}" FontSize="17" FontWeight="Normal" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid
                                                Visibility="{Binding ShowInsulation, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding InsulDryLeft, StringFormat='{}{0:0.00}'}" Foreground="{Binding IsInsulDryLeftOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={StaticResource DryValueBrush}}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding InsulDryRight, StringFormat='{}{0:0.00}'}" Foreground="{Binding IsInsulDryRightOutOfSpec, Converter={StaticResource SpecBrush}, ConverterParameter={StaticResource DryValueBrush}}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="Avr." Style="{StaticResource MutedText}" FontSize="16" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AvrWet, StringFormat='{}{0:0.00} (wet)'}" FontSize="19" Foreground="Black" FontWeight="Normal" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AvrDry, StringFormat='{}{0:0.00} (dry)'}" FontSize="21" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
