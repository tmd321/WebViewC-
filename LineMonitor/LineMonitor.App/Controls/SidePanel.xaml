<UserControl x:Class="LineMonitor.App.Controls.SidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LineMonitor.Core.Models;assembly=LineMonitor.Core"
             xmlns:conv="clr-namespace:LineMonitor.App.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:CollectionHasItemsConverter x:Key="HasItems" />
        <conv:LengthToWidthConverter x:Key="LenToWidth" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}">
        <StackPanel>
            <!-- DS Lane1 ... TOP/BACK ... LaneN OS -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Border Background="{StaticResource BorderBrush2}" Padding="6,2" CornerRadius="3" Margin="0,0,6,0">
                        <TextBlock Text="DS" FontWeight="Bold" />
                    </Border>
                    <Border Background="{StaticResource BorderBrush2}" Padding="6,2" CornerRadius="3">
                        <TextBlock Text="Lane 1" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Title, ElementName=Root}"
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />

                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                    <Border Background="{StaticResource BorderBrush2}" Padding="6,2" CornerRadius="3" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Lanes.Count, StringFormat='Lane {0}'}" FontWeight="Bold" />
                    </Border>
                    <Border Background="{StaticResource BorderBrush2}" Padding="6,2" CornerRadius="3">
                        <TextBlock Text="OS" FontWeight="Bold" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 스트라이프 코팅 패턴(최대 8) + 패턴 사이 무지부(포일) -->
            <Border Visibility="{Binding Patterns, Converter={StaticResource HasItems}}"
                    Background="{StaticResource BgBrush}" CornerRadius="3" Padding="4" Margin="0,0,0,6">
                <ItemsControl ItemsSource="{Binding Patterns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PatternSegment}">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource AccentBrush}" Height="28" Margin="1" CornerRadius="2"
                                        Width="{Binding CoatLength, Converter={StaticResource LenToWidth}}"
                                        ToolTip="{Binding CoatLength, StringFormat='Coat {0:0.0}mm'}">
                                    <TextBlock Text="{Binding Index, StringFormat='P{0}'}" Foreground="White" FontSize="9"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Background="{StaticResource BorderBrush2}" Height="28" Margin="1" CornerRadius="2"
                                        Width="{Binding FoilLength, Converter={StaticResource LenToWidth}, ConverterParameter=1.5}"
                                        Visibility="{Binding FoilLength, Converter={StaticResource NullToVis}}"
                                        ToolTip="{Binding FoilLength, StringFormat='Foil {0:0.0}mm'}">
                                    <TextBlock Text="Foil" Foreground="{StaticResource MutedBrush}" FontSize="8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 레인 사이 간격(에지) tolerance / 컷폭 라벨 -->
            <ItemsControl ItemsSource="{Binding Edges}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EdgeReading}">
                        <StackPanel HorizontalAlignment="Center" Margin="2">
                            <TextBlock Text="{Binding CutLabel}" Style="{StaticResource MutedText}"
                                       Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Center"
                                       Visibility="{Binding CutLabel, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding Wet, StringFormat='{}{0:0.00}'}" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding CutLabel, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                            <TextBlock Text="{Binding Dry, StringFormat='{}{0:0.00}'}" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding CutLabel, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 레인 셀(Wet/Dry 누적 + 절연 좌우) + Avr -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding Lanes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LaneWetDry}">
                            <Border Background="Black" Margin="1" Padding="4" CornerRadius="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding Wet, StringFormat='{}{0:0.00}'}" Foreground="White"
                                               FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Dry, StringFormat='{}{0:0.00}'}" Foreground="#FFD940"
                                               FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding InsulWetLeft, StringFormat='{}{0:0.00}'}" Foreground="#8B96AB" FontSize="9" Margin="0,0,2,0" />
                                        <TextBlock Text="{Binding InsulWetRight, StringFormat='{}{0:0.00}'}" Foreground="#8B96AB" FontSize="9" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding InsulDryLeft, StringFormat='{}{0:0.00}'}" Foreground="#FFD940" FontSize="9" Margin="0,0,2,0" />
                                        <TextBlock Text="{Binding InsulDryRight, StringFormat='{}{0:0.00}'}" Foreground="#FFD940" FontSize="9" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Avr." Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AvrWet, StringFormat='{}{0:0.00} (wet)'}" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AvrDry, StringFormat='{}{0:0.00} (dry)'}" FontSize="11" Foreground="#FFD940" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
